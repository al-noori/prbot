# Copy to .env and fill in.

# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Slack: bot token (OAuth & Permissions, xoxb-...) and app-level token with connections:write (xapp-...)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Your Slack member ID (profile > ... > Copy member ID). Only this user can use the bot.
SLACK_OWNER_ID=

# Optional. If empty, the token from `gh auth token` is used.
GITHUB_TOKEN=

# Optional
# PRBOT_STATE=prbot-state.json
# MAX_REVIEWS_PER_RUN=5
# SKIP_DRAFTS=true
