# prbot settings. `prbot setup` writes this file for you; edit it by hand only if you want to.
# prbot reads .env from PRBOT_HOME, else the current directory, else %APPDATA%\prbot (Windows)
# or ~/.config/prbot (macOS, Linux).

# Optional. Claude API key (platform.claude.com). If empty, reviews run through the Claude Code CLI
# (`claude`, logged in with your Claude account). CLAUDE_BIN overrides the path to it.
ANTHROPIC_API_KEY=

# Slack: bot token (OAuth & Permissions, xoxb-...) and app-level token with connections:write (xapp-...)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Your Slack member ID. Only this user can use the bot.
SLACK_OWNER_ID=

# Optional. If empty, the token from `gh auth token` is used.
GITHUB_TOKEN=

# Optional. Default model and effort; /prreview model and /prreview effort override them.
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Optional
# PRBOT_STATE=prbot-state.json
# MAX_REVIEWS_PER_RUN=5
# SKIP_DRAFTS=true
